# 后端配置示例（请复制为 .env 并填入真实值，不要提交到仓库）

# Supabase 项目地址：例如 https://xxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase 项目 anon key（仅供后端转发邮箱验证码登录使用）
SUPABASE_ANON_KEY=

# Supabase service role key（仅服务器使用，绝不要放到前端/小程序）
SUPABASE_SERVICE_ROLE_KEY=

# Setup-only variables used by `npm run setup:supabase`.
# Keep these local. Do not commit filled values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_SLUG=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=ap-southeast-1
SUPABASE_PROJECT_NAME=qian-duo-duo
SUPABASE_ENV_PATH=server/.env.local
